#!/usr/bin/env node

const fs = require('fs')
const path = require('path')

// TipTap版本号
const TIPTAP_VERSION = '3.0.0-beta.22'

console.log('🔧 开始修复 workspace 依赖...\n')

// 查找所有 package.json 文件
function findPackageJsonFiles() {
  const files = []

  // 扫描 packages 和 packages-deprecated 目录
  const mainDirs = ['packages', 'packages-deprecated']

  mainDirs.forEach(mainDir => {
    if (fs.existsSync(mainDir)) {
      const subDirs = fs.readdirSync(mainDir)
      subDirs.forEach(subDir => {
        const packageJsonPath = path.join(mainDir, subDir, 'package.json')
        if (fs.existsSync(packageJsonPath)) {
          files.push(packageJsonPath)
        }
      })
    }
  })

  return files
}

const packageJsonFiles = findPackageJsonFiles()

let fixedCount = 0

packageJsonFiles.forEach(filePath => {
  const packageJson = JSON.parse(fs.readFileSync(filePath, 'utf8'))
  let hasChanges = false

  // 修复 dependencies
  if (packageJson.dependencies) {
    Object.entries(packageJson.dependencies).forEach(([dep, version]) => {
      if (dep.startsWith('@tiptap/') && version === 'workspace:*') {
        packageJson.dependencies[dep] = TIPTAP_VERSION
        console.log(`✅ ${filePath}: ${dep} workspace:* → ${TIPTAP_VERSION}`)
        hasChanges = true
      }
    })
  }

  // 修复 devDependencies
  if (packageJson.devDependencies) {
    Object.entries(packageJson.devDependencies).forEach(([dep, version]) => {
      if (dep.startsWith('@tiptap/') && version === 'workspace:*') {
        packageJson.devDependencies[dep] = TIPTAP_VERSION
        console.log(`✅ ${filePath}: ${dep} workspace:* → ${TIPTAP_VERSION}`)
        hasChanges = true
      }
    })
  }

  // 修复 peerDependencies
  if (packageJson.peerDependencies) {
    Object.entries(packageJson.peerDependencies).forEach(([dep, version]) => {
      if (dep.startsWith('@tiptap/') && version === 'workspace:*') {
        packageJson.peerDependencies[dep] = TIPTAP_VERSION
        console.log(`✅ ${filePath}: ${dep} workspace:* → ${TIPTAP_VERSION}`)
        hasChanges = true
      }
    })
  }

  if (hasChanges) {
    fs.writeFileSync(filePath, `${JSON.stringify(packageJson, null, 2)}\n`)
    fixedCount += 1
  }
})

console.log(`\n🎉 修复了 ${fixedCount} 个 package.json 文件!`)
console.log('\n下一步: 重新打包 TipTap 扩展...')
