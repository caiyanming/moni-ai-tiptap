{
  "name": "@tiptap/extension-file-children-block",
  "description": "File children block extension for TipTap - AI anchor and sub-document manager",
  "version": "3.0.0-beta.22.3",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "tiptap extension",
    "file children",
    "null uuid",
    "ai anchor",
    "sub-document",
    "document manager"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@tiptap/core": "workspace:*",
    "@tiptap/pm": "workspace:*",
    "@tiptap/extension-document": "workspace:*",
    "@tiptap/extension-paragraph": "workspace:*",
    "@tiptap/extension-text": "workspace:*",
    "vitest": "^2.0.0",
    "jsdom": "^23.0.0",
    "@vitest/ui": "^2.0.0"
  },
  "peerDependencies": {
    "@tiptap/core": "3.0.0-beta.22.3",
    "@tiptap/pm": "3.0.0-beta.22.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ueberdosis/tiptap",
    "directory": "packages/extension-file-children-block"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  }
}
