{
  "name": "tiptap",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "scripts": {
    "cz": "cz",
    "start": "pnpm --prefix ./demos run start",
    "dev": "pnpm run start",
    "lint": "turbo run lint",
    "lint:fix": "prettier -w --log-level warn . && eslint --fix --cache --quiet --no-error-on-unmatched-pattern .",
    "lint:staged": "lint-staged",
    "test:unit": "vitest run --config=tests/configs/vitest.config.ts",
    "test:unit:watch": "vitest --config=tests/configs/vitest.config.ts",
    "test:unit:ui": "vitest --ui --config=tests/configs/vitest.config.ts",
    "test:unit:coverage": "vitest --coverage --config=tests/configs/vitest.config.ts",
    "test:unit:core": "vitest run tests/unit/core/**/*.test.ts --config=tests/configs/vitest.config.ts",
    "test:unit:core:watch": "vitest tests/unit/core/**/*.test.ts --config=tests/configs/vitest.config.ts",
    "test:unit:moni": "vitest run tests/unit/moni/**/*.test.ts --config=tests/configs/vitest.config.ts",
    "test:unit:moni:watch": "vitest tests/unit/moni/**/*.test.ts --config=tests/configs/vitest.config.ts",
    "test:unit:components": "vitest run tests/unit/components/**/*.test.{ts,tsx} --config=tests/configs/vitest.config.ts",
    "test:unit:components:watch": "vitest tests/unit/components/**/*.test.{ts,tsx} --config=tests/configs/vitest.config.ts",
    "test:unit:extensions": "vitest run tests/unit/extensions/**/*.test.{ts,tsx} --config=tests/configs/vitest.config.ts",
    "test:unit:extensions:watch": "vitest tests/unit/extensions/**/*.test.{ts,tsx} --config=tests/configs/vitest.config.ts",
    "test:stream": "vitest run tests/unit/moni/stream/*.test.ts --config=tests/configs/vitest.config.ts",
    "test:stream:watch": "vitest tests/unit/moni/stream/*.test.ts --config=tests/configs/vitest.config.ts",
    "test:drag": "vitest run tests/unit/moni/drag/*.test.ts --config=tests/configs/vitest.config.ts",
    "test:drag:watch": "vitest tests/unit/moni/drag/*.test.ts --config=tests/configs/vitest.config.ts",
    "test:integration": "cypress run --config-file tests/configs/cypress.config.js",
    "test:integration:open": "cypress open --config-file tests/configs/cypress.config.js",
    "test:e2e": "playwright test --config=tests/configs/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=tests/configs/playwright.config.ts",
    "test:e2e:headed": "playwright test --headed --config=tests/configs/playwright.config.ts",
    "test:e2e:drag": "playwright test tests/e2e/drag-behavior --config=tests/configs/playwright.config.ts",
    "test:e2e:performance": "playwright test tests/e2e/performance --config=tests/configs/playwright.config.ts",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e",
    "test:ci": "pnpm run test:unit:coverage && pnpm run test:integration && pnpm run test:e2e",
    "test:quick": "pnpm run test:unit",
    "test:full": "pnpm run test",
    "build": "turbo build",
    "build:low-memory": "turbo build:low-memory --concurrency=4",
    "build:serial": "turbo build --concurrency=1",
    "build:demos": "pnpm  --prefix demos run build:demos",
    "serve": "pnpm run build:demos && http-server ./demos/dist -s -p 3000",
    "build:ci": "turbo run build",
    "publish": "pnpm run build && pnpm changeset publish",
    "clean:packages": "rm -rf ./packages/*/dist && rm -rf ./packages/pm/*/dist && rm -rf ./packages-deprecated/*/dist",
    "clean:packs": "rm -rf ./packages/*/*.tgz && rm -rf ./packages-deprecated/*/*.tgz",
    "reset": "pnpm run clean:packages && pnpm run clean:packs && rm -rf ./**/.cache && rm -rf ./**/node_modules && rm -rf ./package-lock.json && pnpm install",
    "prepare": "husky install",
    "turbo": "turbo",
    "changeset": "changeset",
    "version": "pnpm run changeset -- version && pnpm install --no-frozen-lockfile",
    "install-design-system": "scripts/install-design-system.sh",
    "install-design-system:clean": "scripts/install-design-system.sh --clean",
    "update-design-system": "node scripts/update-design-system-deps.cjs"
  },
  "dependencies": {
    "@moni-ai-design-system": "file:../moni-ai-design-system",
    "moni-ai-design-system": "file:../moni-ai-design-system"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@changesets/cli": "^2.27.11",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@csstools/postcss-cascade-layers": "^5.0.2",
    "@csstools/postcss-oklab-function": "^4.0.10",
    "@cypress/webpack-preprocessor": "^6.0.2",
    "@playwright/test": "^1.54.1",
    "@testing-library/react": "16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@zeecoder/postcss-container-query": "^3.1.0",
    "babel-loader": "^9.2.1",
    "cypress": "^14.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-cypress": "^2.15.2",
    "eslint-plugin-html": "^6.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-vue": "^9.32.0",
    "http-server": "14.1.1",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "katex": "^0.16.4",
    "lint-staged": "^15.3.0",
    "lowlight": "^3.3.0",
    "minimist": "^1.2.8",
    "pkg-pr-new": "0.0.32",
    "postcss-custom-properties": "^14.0.6",
    "postcss-import": "^15.1.0",
    "postcss-nesting": "^13.0.2",
    "prettier": "3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tinyglobby": "0.2.10",
    "ts-loader": "9.3.1",
    "tsup": "^8.3.5",
    "turbo": "2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "webpack": "^5.97.1"
  },
  "overrides": {
    "@rollup/pluginutils": "^5.1.4"
  },
  "publishConfig": {
    "provenance": true
  },
  "lint-staged": {
    "./**/*.{ts,tsx,js,jsx,vue}": [
      "prettier --write",
      "eslint --fix --quiet --no-error-on-unmatched-pattern"
    ]
  }
}
