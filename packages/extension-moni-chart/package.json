{
  "name": "@tiptap/extension-moni-chart",
  "description": "chart visualization extension for tiptap",
  "version": "3.0.0-beta.22.3",
  "keywords": [
    "tiptap",
    "tiptap extension",
    "chart",
    "echarts",
    "visualization"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": {
        "import": "./dist/react.d.ts",
        "require": "./dist/react.d.cts"
      },
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@tiptap/core": "workspace:*",
    "@tiptap/pm": "workspace:*",
    "@tiptap/react": "workspace:*",
    "@types/react": "^18.2.0"
  },
  "peerDependencies": {
    "@tiptap/core": "3.0.0-beta.22.3",
    "@tiptap/pm": "3.0.0-beta.22.3",
    "echarts": "^5.5.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
