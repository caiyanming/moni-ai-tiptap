{
  "name": "@tiptap/extension-diff-block",
  "version": "3.0.0-beta.22",
  "description": "DiffBlock extension for Moni AI Block Stream operations with git diff style confirmation",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "tiptap",
    "extension",
    "diff",
    "block",
    "git-diff",
    "ai",
    "confirmation"
  ],
  "author": "MoniAI Team",
  "license": "MIT",
  "dependencies": {
    "@tiptap/core": "workspace:*",
    "@tiptap/pm": "workspace:*"
  },
  "devDependencies": {
    "@tiptap/core": "workspace:*",
    "@tiptap/pm": "workspace:*",
    "vitest": "^2.0.0",
    "jsdom": "^23.0.0",
    "@vitest/ui": "^2.0.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0-beta.22",
    "@tiptap/pm": "^3.0.0-beta.22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ueberdosis/tiptap",
    "directory": "packages/extension-diff-block"
  }
}