{
  "name": "@tiptap/extension-nesting",
  "description": "nesting extension for tiptap - block-level nesting management",
  "version": "3.0.0-beta.22.4",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "tiptap extension",
    "nesting",
    "hierarchy",
    "block management"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@tiptap/core": "workspace:*",
    "@tiptap/pm": "workspace:*"
  },
  "peerDependencies": {
    "@tiptap/core": "3.0.0-beta.22.4",
    "@tiptap/pm": "3.0.0-beta.22.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ueberdosis/tiptap",
    "directory": "packages/extension-nesting"
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
