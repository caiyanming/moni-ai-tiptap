  "version": "3.0.0-beta.22",
  "homepage": "https://tiptap.dev",
  "keywords": [
    "tiptap",
    "editor",
    "styling",
    "stream",
    "ai",
    "moni",
    "prosemirror"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
