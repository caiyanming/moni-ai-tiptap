{
  "name": "@tiptap/extension-chemistry",
  "description": "chemistry formula extension for tiptap",
  "version": "3.0.0-beta.22.2",
  "homepage": "https://tiptap.dev/api/extensions/chemistry",
  "keywords": [
    "tiptap",
    "tiptap extension",
    "chemistry",
    "chemical formula",
    "mhchem"
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ueberdosis/tiptap",
    "directory": "packages/extension-chemistry"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": {
        "import": "./dist/react.d.ts",
        "require": "./dist/react.d.cts"
      },
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@tiptap/core": "workspace:*",
    "@tiptap/pm": "workspace:*",
    "@tiptap/react": "workspace:*",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.2.0"
  },
  "peerDependencies": {
    "@tiptap/core": "3.0.0-beta.22.1",
    "@tiptap/pm": "3.0.0-beta.22.1",
    "katex": "^0.16.4"
  },
  "peerDependenciesMeta": {
    "@tiptap/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "prettier ./src/ --check && eslint --cache --quiet --no-error-on-unmatched-pattern ./src/"
  }
}
